# =============================================================================
# Conzoomer — backend environment (Django)
# Copy to backend/.env (or .env in the repo root) and fill in the values.
# Never commit the real .env file.
# =============================================================================

# --- Core -------------------------------------------------------------------
# true for local development only. Production MUST be false.
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Hosts Django will answer for. Include the storefront domain (requests are
# proxied through it) and the backend's own domain in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to send POSTs with the CSRF cookie (scheme + host).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Public URL of the storefront. Used for email links and redirects.
FRONTEND_URL=http://localhost:3000
# Optional production tuning (defaults shown)
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=2592000
# DJANGO_USE_X_FORWARDED_HOST=true
# Force the public host for absolute URLs if your proxy does not send X-Forwarded-Host
# DJANGO_PUBLIC_HOST=conzoomer.vercel.app
# DJANGO_TRUST_X_FORWARDED_PROTO=true   (defaults to true when DEBUG is false)
# LOG_LEVEL=INFO

# --- Database (Neon or Supabase PostgreSQL) -----------------------------------
# Neon: Dashboard → Connect → copy the connection string (keep sslmode=require).
# Example: postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/conzoomer?sslmode=require
DATABASE_URL=
# Seconds to keep DB connections open (0 = close after each request)
DB_CONN_MAX_AGE=60

# --- Google sign-in (Google Cloud Console → Google Auth Platform → Clients) ----
# Leave blank to hide the Google button. The secret stays on the server.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Local-only "Developer sign-in" button for demonstrating account pages before
# Google is configured. Ignored unless DJANGO_DEBUG=true.
DEV_LOGIN_ENABLED=false

# --- Email ---------------------------------------------------------------------
# preview = save rendered emails to backend/var/email-previews/ (nothing is sent)
# mailgun = deliver through the Mailgun HTTP API
MAIL_BACKEND=preview
MAILGUN_API_KEY=
# Your verified sending domain, e.g. mg.yourdomain.com, or the sandbox domain
MAILGUN_DOMAIN=
# us or eu — must match the region the domain was created in
MAILGUN_REGION=us
MAIL_FROM=Conzoomer <orders@mg.yourdomain.com>
MAIL_REPLY_TO=
SUPPORT_EMAIL=hello@conzoomer.example
# Try to send right after checkout (the worker retries anything that fails)
MAIL_SEND_ON_COMMIT=true
MAIL_MAX_ATTEMPTS=6
MAIL_HTTP_TIMEOUT=8

# --- Commerce rules (demo values — not tax advice) --------------------------------
CURRENCY_CODE=USD
DEMO_TAX_RATE=0.08
TAX_LABEL=Estimated sales tax (demo rate)
FREE_SHIPPING_THRESHOLD=75.00
SHIPPING_STANDARD_PRICE=6.00
SHIPPING_EXPRESS_PRICE=15.00
MAX_QUANTITY_PER_ITEM=10

# --- Rate limits (DRF throttle syntax) ------------------------------------------
THROTTLE_CATALOG=300/min
THROTTLE_CART=120/min
THROTTLE_CHECKOUT=10/min
THROTTLE_ORDER_LOOKUP=30/min
THROTTLE_AUTH=20/min
